@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@VISIONRT_BUILD_PYTHON_INTEROP@)
    find_dependency(Python3 REQUIRED COMPONENTS Interpreter Development.Embed)
    set(PYBIND11_FINDPYTHON ON)
    find_dependency(pybind11 CONFIG REQUIRED)
endif()
find_dependency(OpenCV REQUIRED COMPONENTS core)
if(NOT TARGET yaml-cpp::yaml-cpp AND NOT TARGET yaml-cpp)
    find_dependency(yaml-cpp REQUIRED HINTS "${CMAKE_CURRENT_LIST_DIR}/../yaml-cpp" "${PACKAGE_PREFIX_DIR}/lib/cmake/yaml-cpp")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VisionRTToolSDKTargets.cmake")
check_required_components(VisionRTToolSDK)
